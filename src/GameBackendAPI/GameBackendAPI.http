@GameBackendAPI_HostAddress = http://localhost:5192

# ------------------ Health -----------------------------

GET {{GameBackendAPI_HostAddress}}/health-readiness/

###

GET {{GameBackendAPI_HostAddress}}/health-liveness/

###

# -------------------------- Registration ------------------------------

# Valid Registration
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test3@test.com", "Password": "TestPassword", "Username": "Test3User"}

###

# The same username again, with a different email
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test2@test.com", "Password": "TestPassword", "Username": "TestUser"}

###

# The same username in a different case
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test@test.com", "Password": "TestPassword", "Username": "testuser"}

###

# The same email, with a different username
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test@test.com", "Password": "TestPassword", "Username": "TestUser_1"}

###

#  An invalid email
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "testtest.com", "Password": "TestPassword", "Username": "testuser"}

###

#  A password shorter than 8 characters
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test1@test.com", "Password": "TestPas", "Username": "TestUser_1"}

###

#  A username containing a space
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test2@test.com", "Password": "TestPassword", "Username": "Test User"}

###

# A missing field
POST {{GameBackendAPI_HostAddress}}/players
Content-type: application/json

{"Email": "test@test.com", "Username": "TestUser"}

###

# --------------------------- Auth ------------------------------

# Fresh User
# @name GenerateToken
POST {{GameBackendAPI_HostAddress}}/auth/login
Content-type: application/json

{"Email": "test@test.com", "Password": "TestPassword"}
###

# Wrong Password
POST {{GameBackendAPI_HostAddress}}/auth/login
Content-type: application/json

{"Email": "test@test.com", "Password": "testPasswordWrong"}
###

# Unknown Email
POST {{GameBackendAPI_HostAddress}}/auth/login
Content-type: application/json

{"Email": "testUnknown@test.com", "Password": "TestPassword"}
###

# Missing field
POST {{GameBackendAPI_HostAddress}}/auth/login
Content-type: application/json

{"Email": "test@test.com"}
###

# Correct email with different case
POST {{GameBackendAPI_HostAddress}}/auth/login
Content-type: application/json

{"Email": "Test@test.com", "Password": "TestPassword"}
###

# Owner Profile Get
GET {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

###

# Owner Profile Get without token
GET {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json

###

# Owner Profile Patch
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Email": "Test2@test.com", "Username": "Test2Updated"}
###

# Owner Profile Patch empty input
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Email": "", "Username": ""}
###

# Owner Profile Patch empty input
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Email": "Test3@test.com", "Username": "Test3User"}
###

# Owner Profile Patch only email
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Email": "Test2@test.com"}
###

# Owner Profile Patch only username
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Username": "TestUpdated"}
###

# Owner Profile Patch with extra fields
PATCH {{GameBackendAPI_HostAddress}}/players/me
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

{"Email": "Test2@test.com", "Username": "Test2Updated", "Rating": 10}
###

# Get public profile player
GET {{GameBackendAPI_HostAddress}}/players/9
Content-type: application/json
Authorization: Bearer {{GenerateToken.response.body.$.token}}

###
